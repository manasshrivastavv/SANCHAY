# ==========================================
# SANCHAY BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Firebase Admin SDK Service Account Credentials (from Firebase Console -> Project Settings -> Service accounts)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# MongoDB Database Configuration (MongoDB Atlas or local)
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=sanchay_db

# Google Gemini API Key for Sakhi Assistant
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Application Origin (CORS allowed origins)
FRONTEND_URL=http://localhost:5173

# Admin API Secret Key
ADMIN_API_KEY=sanchay_admin_secret_key_2026

# Server Port
PORT=8000
