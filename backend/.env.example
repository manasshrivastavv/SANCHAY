# ==========================================
# SANCHAY BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Clerk Secret Key (from Clerk Dashboard -> API Keys -> Secret Keys)
# NEVER commit real credentials. Keep secret on Render backend.
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# MongoDB Database Configuration (MongoDB Atlas or local)
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=sanchay_db

# Google Gemini API Key for Sakhi Assistant
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Application Origin (CORS allowed origins)
FRONTEND_URL=http://localhost:5173

# Admin API Secret Key
ADMIN_API_KEY=sanchay_admin_secret_key_2026

# Server Port
PORT=8000
