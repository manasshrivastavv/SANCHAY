# ==========================================
# SANCHAY ENVIRONMENT CONFIGURATION
# ==========================================

# ------------------------------------------
# Frontend Variables (Vercel / Local Vite)
# ------------------------------------------
# Clerk Publishable Key (from Clerk Dashboard -> API Keys)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Backend API URL (leave empty in production on Vercel if using reverse proxy, or set to Render URL)
VITE_API_URL=http://127.0.0.1:8000

# ------------------------------------------
# Backend Variables (Render / Local FastAPI)
# ------------------------------------------
# Clerk Secret Key (from Clerk Dashboard -> API Keys -> Secret Keys)
# NEVER expose this key in frontend code or commits!
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Optional: Custom Clerk JWKS URL (auto-discovered from Clerk JWT issuer if omitted)
# CLERK_JWKS_URL=https://api.clerk.com/v1/jwks

# MongoDB Database Configuration
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=sanchay_db

# Google Gemini API Key for Sakhi Assistant
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Application Origin (CORS)
FRONTEND_URL=http://localhost:5173

# Admin API Secret Key for Scheme Import & Management
ADMIN_API_KEY=sanchay_admin_secret_key_2026

# Server Port
PORT=8000
